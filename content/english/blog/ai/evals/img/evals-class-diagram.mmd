%% ===== Production monitoring =====
class SampledRequest:::monitor {
    +input
    +output
    +timestamp
}
class ProductionSampler:::monitor {
    +should_sample()
    +evaluate_sample()
    +flush()
    +stats()
}
class QualityWindow:::monitor {
    +start
